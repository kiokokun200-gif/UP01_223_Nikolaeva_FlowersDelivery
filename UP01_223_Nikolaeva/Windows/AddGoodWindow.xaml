<Window x:Class="UP01_223_Nikolaeva.Windows.AddGoodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP01_223_Nikolaeva.Windows"
        mc:Ignorable="d"
        Title="AddGoodWindow" Height="450" Width="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition  Height="auto"/>
            <RowDefinition  Height="*"/>
        </Grid.RowDefinitions>
        

        <StackPanel Grid.Column="0" >
            <TextBlock Text="Введите название товара: " Margin="10 10 0 10"/>
            <TextBlock Text="Введите цену: " Margin="10 0"/>
            <TextBlock Text="Введите путь к изображению: " Margin="10 10 0 10"/>
            <TextBlock Text="Выберите категорию товара: " Margin="10 0"/>
            
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBox x:Name="TxtBoxName" Margin=" 0 10 10 7"/>
            <TextBox x:Name="TxtBoxPrice" Margin="0 0 10 0"/>
            <TextBox x:Name="TxtBoxImage" Margin="0 10 10 0"/>
            <ComboBox x:Name="ComboBoxCategory" Width="200" Margin="0 5" SelectedIndex="0"/>
        </StackPanel>

        <Button x:Name="BtnAddGood" Content="Добавить" HorizontalAlignment="Center" FontFamily="Times New Roman" Grid.Row="1" Grid.ColumnSpan="2" Height="30" VerticalAlignment="Top" Margin="10" Click="BtnAddGood_Click"/>
    </Grid>
</Window>
