<Window x:Class="UP01_223_Nikolaeva.Windows.EditGoodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP01_223_Nikolaeva.Windows"
        mc:Ignorable="d"
        Title="EditGoodWindow" Height="350" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            
            
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" Source="{Binding Image}" Width="250"/>


        <StackPanel Grid.Column="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" >
                    <TextBlock Text="Название: " Margin="10 10 0 10"/>
                    <TextBlock Text="Цена: " Margin="10 0"/>
                    <TextBlock Text="Путь к изображению" Margin="10 10"/>
                    <TextBlock Text="Категория: " Margin="10 0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Left">

                    <TextBox x:Name="TxtBoxName" Text="{Binding Name}" Width="200" Margin="0 7"/>
                    <TextBox x:Name="TxtBoxPrice" Text="{Binding Price}" Width="200" Margin="0 0 0 10"/>
                    <TextBox x:Name="TxtBoxImage" Text="{Binding ImagePath}" Width="200" Margin="0 0 0 7"/>
                    <ComboBox x:Name="ComboBoxCategory" Width="200"/>
                </StackPanel>

                <Button x:Name="BtnSave" Grid.Row="1" Grid.ColumnSpan="2" Content="Сохранить" Margin="10" Width="150" HorizontalAlignment="Left" Click="BtnSave_Click"/>
                
            </Grid>
            
        </StackPanel>
    </Grid>
</Window>
