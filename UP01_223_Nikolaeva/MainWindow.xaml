<Window x:Class="UP01_223_Nikolaeva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP01_223_Nikolaeva"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Closing="Window_Closing">
    <Grid>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"
               Source="/Pages/AuthPage.xaml" Margin="0,40,0,0"/>
        <StackPanel x:Name="TopRightPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="10"
                    >
            <Button x:Name="BtnTheme" Content="🌓" Width="30" Height="30"
                    Margin="0,0,5,0" Click="BtnTheme_Click"
                    ToolTip="Сменить тему" />
            <Button x:Name="BtnAccount" Width="40" Height="30"
                    Click="BtnAccount_Click"
                    ToolTip="Личный кабинет"
                    Background="Transparent" BorderThickness="0">
                <Button.Content>
                    <Image Source="/res/account.png" Width="24"/>
                </Button.Content>
            </Button>
        </StackPanel>
        <Button x:Name="BtnBack" Content="Назад" Width="70" Margin="10" Background="#FFFF7B8E" Foreground="White" Height="35" FontSize="23" VerticalAlignment="Bottom" 
                 HorizontalAlignment="Left" Click="BtnBack_Click"/>
    </Grid>
</Window>
