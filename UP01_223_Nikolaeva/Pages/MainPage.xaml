<Page x:Class="UP01_223_Nikolaeva.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_223_Nikolaeva.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid  >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Column="0">
            <TextBlock Text="⌕" FontSize="20" Margin="10 10"/>
            <Grid>
                <TextBox x:Name="TxtBoxSearch" Width="200" Margin="10 10" TextChanged="TxtBoxSearch_TextChanged"/>
                <TextBlock x:Name="SearchPlaceHolder" Text="Найти товары" Margin="20 16" Foreground="Gray" MouseLeftButtonUp="SearchPlaceHolder_MouseLeftButtonUp"/>
                
            </Grid>
            <ComboBox x:Name="ComboBoxSort" Width="150" Height="30" SelectedIndex="0" SelectionChanged="ComboBoxSort_SelectionChanged"/>
            <ComboBox x:Name="ComboBoxFiltr" Margin="10 0" Width="150" Height="30" SelectedIndex="0" SelectionChanged="ComboBoxFiltr_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Сменить тему" x:Name="BtnChangeTheme" Click="BtnChangeTheme_Click" />
            <Button x:Name="BtnAccount" Background="Transparent" BorderThickness="0" Margin="10">
                <Button.Content>
                    <Image Source="/res/account.png" Width="30"/>
                </Button.Content>
            </Button>
        </StackPanel>

        <ListBox Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="ListBoxGoods" Grid.ColumnSpan="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.ColumnSpan="2" Source="{Binding Image}" Width="100" Height="100"/>

                            <Button x:Name="BtnEditGood" Content="✎" Width="20" Height="20" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FFBDFFA0" Visibility="{Binding VisIsAdmin}" Click="BtnEditGood_Click"/>
                            <Button x:Name="BtnDeleteGood" Content="🗑️" Width="20" Height="20" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFF3657B" Visibility="{Binding VisIsAdmin}" Click="BtnDeleteGood_Click"/>

                        </Grid>
                        <TextBlock Text="{Binding Name}"/>
                        
                        <TextBlock Text="{Binding Price, StringFormat={}{0} ₽}" FontSize="18"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Rating, StringFormat={}★ {0:0.#}}" Foreground="#FFCA9E00" />
                            <TextBlock Text="{Binding ReviewCount, StringFormat={}{0} оценок}" Margin="3 0" Foreground="#FF757575"/>
                        </StackPanel>
                        

                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Button x:Name="BtnAddGood" Content="➕" Background="Transparent" Grid.Row="1" HorizontalAlignment="Right" FontSize="28" BorderThickness="0" 
                Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="20" Width="40" Height="40" Visibility="{Binding VisIsAdmin}" Click="BtnAddGood_Click"/>
    </Grid>
</Page>
