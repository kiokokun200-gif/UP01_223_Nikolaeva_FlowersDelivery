<Page x:Class="UP01_223_Nikolaeva.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_223_Nikolaeva.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="⌕" FontSize="20" Margin="5 10"/>
            <Grid>
                <TextBox x:Name="TxtBoxSearch" Style="{StaticResource TextBoxxx}" Margin="10 10" TextChanged="TxtBoxSearch_TextChanged"/>
                <TextBlock x:Name="SearchPlaceHolder" Text="Найти товары" Margin="17 14" Foreground="Gray" MouseLeftButtonUp="SearchPlaceHolder_MouseLeftButtonUp"/>
                
            </Grid>
            <ComboBox x:Name="ComboBoxSort" Width="150" Height="30" SelectedIndex="0" SelectionChanged="ComboBoxSort_SelectionChanged"/>
            <ComboBox x:Name="ComboBoxFiltr" Margin="10 0" Width="150" Height="30" SelectedIndex="0" SelectionChanged="ComboBoxFiltr_SelectionChanged"/>
        </StackPanel>

        <ListBox Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="ListBoxGoods">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        
                        <Image Source="{Binding Image}" Width="100" Height="100"/>
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Price, StringFormat={}{0} ₽}" FontSize="18"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
