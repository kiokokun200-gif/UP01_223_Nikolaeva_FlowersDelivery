<Page x:Class="UP01_223_Nikolaeva.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_223_Nikolaeva.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Аккаунт">

    <Grid>
        
        <StackPanel Margin="10">
            <TextBlock Text="{Binding Name}" FontSize="20"/>
            <TextBlock Text="{Binding Email, StringFormat=Почта: {0}}"/>
            <TextBlock Text="{Binding Phone, StringFormat=Номер телефона: {0}}"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Выйти" x:Name="BtnLogOut" Margin="0 0 20 0" Click="BtnLogOut_Click"/>
                <Button Content="Сменить пароль" x:Name="BtnChangePassword"  Click="BtnChangePassword_Click"/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Page>
