<Page x:Class="UP01_223_Nikolaeva.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_223_Nikolaeva.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid >
        <TabControl>
            <TabItem Header="Вход">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" x:Name="StackLogin">
                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <Label Content="Логин:" x:Name="LabelLogin" />
                            <Label Content="Пароль:" x:Name="LabelPass"/>
                        
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Left" >
                            <TextBox x:Name="TxtBoxLogin" Width="200" Margin="0 3 0 10" ToolTip="Введите логин"/>
                            <PasswordBox x:Name="PassPassword" Width="200" ToolTip="Введите пароль"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="StackCaptcha" Visibility="Collapsed">
                        <TextBlock Text="Введите капчу" Margin="10"/>
                        <TextBlock x:Name="TxtBoxCaptcha" ContextMenu="{x:Null}" Grid.ColumnSpan="2" Grid.RowSpan="2"
                                  Foreground="Red" FontStyle="Italic" FontWeight="Heavy" Margin="10" FontStretch="ExtraCondensed" Background="{x:Null}" RenderTransformOrigin="0.5,0.5" >
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBox x:Name="TxtBoxCaptchaInput" Width="200" Height="30" Margin="10" CommandManager.PreviewExecuted="TxtBoxCaptchaInput_PreviewExecuted"/>
                        <Button x:Name="BtnSubmitCaptcha" Content="Подтвердить" Click="BtnSubmitCaptcha_Click"/>
                    </StackPanel>

                    <Button x:Name="BtnLogin" Content="Войти" Grid.ColumnSpan="2" Grid.Row="1" Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Click="BtnLogin_Click"/>

                </Grid>
            </TabItem>

            <TabItem Header="Регистрация">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <Label Content="Имя:"  />
                        <Label Content="Логин:"  />
                        <Label Content="Номер:" />
                        <Label Content="Пароль:" />
                        

                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Left" Grid.Row="0">
                        <TextBox x:Name="TxtBoxRegName" Margin="0 3 0 7" Width="200" ToolTip="Введите имя"/>
                        <TextBox x:Name="TxtBoxRegLogin" Margin="0 3 0 7" Width="200" ToolTip="Введите email"/>
                        <TextBox x:Name="TxtBoxRegPhone" Margin="0 0 0 7"  Width="200" ToolTip="Введите телефон"/>
                        <PasswordBox x:Name="PassRegPassword" Margin="0 0 0 10" Width="200" ToolTip="Введите пароль"/>
                    </StackPanel>
                    <Button x:Name="BtnRegister" Content="Зарегистрироваться" Grid.ColumnSpan="2" Grid.Row="1" Width="120" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Click="BtnRegister_Click"/>

                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
