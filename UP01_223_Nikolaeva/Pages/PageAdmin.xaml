<Page x:Class="UP01_223_Nikolaeva.Pages.PageAdmin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_223_Nikolaeva.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageAdmin">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Column="0">
            <TextBlock Text="⌕" FontSize="20" Margin="10 10"/>
            <Grid>
                <TextBox x:Name="TxtBoxSearch" Width="200" Margin="10 10" TextChanged="TxtBoxSearch_TextChanged" Padding="3"/>
                <TextBlock x:Name="SearchPlaceHolder" Margin="20 16" Foreground="Gray" MouseLeftButtonUp="SearchPlaceHolder_MouseLeftButtonUp"/>

            </Grid>
            <ComboBox x:Name="ComboBoxSort" Width="150" Height="30" SelectionChanged="ComboBoxSort_SelectionChanged"/>
            <ComboBox x:Name="ComboBoxFiltr" Margin="10 0" Width="150" Height="30"  SelectionChanged="ComboBoxFiltr_SelectionChanged"/>
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="TabControlTable" SelectionChanged="TabControlTable_SelectionChanged">
            <TabItem Header="Товары" Tag="Good">
                <DataGrid x:Name="DataGridGoods" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="auto"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="auto"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="auto"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding GoodCategory.Name}" Width="auto"/>
                        <DataGridTextColumn Header="Изображение" Binding="{Binding ImagePath}" Width="auto"/>
                        <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" Width="auto"/>
                        <DataGridTemplateColumn Header="Действия" Width="auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnEditGood" Content="✏️" Click="BtnEditGood_Click" Margin="3" Background="Transparent"/>
                                        <Button x:Name="BtnDeleteGood" Content="🗑️" Click="BtnDeleteGood_Click" Margin="3" Background="Transparent"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Заказы" Tag="Order">
                <DataGrid x:Name="DataGridOrders" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="auto"/>
                        <DataGridTextColumn Header="Дата заказа" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="auto"/>
                        <DataGridTextColumn Header="Дата доставки" Binding="{Binding DeliveryDate, StringFormat={}{0:dd.MM.yyyy}}" Width="auto"/>
                        <DataGridTextColumn Header="Адрес доставки" Binding="{Binding DeliveryAddress.FullAddress}" Width="auto"/>
                        <DataGridTextColumn Header="Курьер" Binding="{Binding User.Name}" Width="auto"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding User1.Name}" Width="auto"/>
                        <DataGridTextColumn Header="Флорист" Binding="{Binding User2.Name}" Width="auto"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding OrderStatus.Name}" Width="auto"/>
                        <DataGridTextColumn Header="Способ оплаты" Binding="{Binding PaymentMethod.Name}" Width="auto"/>
                        <DataGridTemplateColumn Header="Действия" Width="auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnEditOrder" Content="✏️" Click="BtnEditOrder_Click" Margin="3" Background="Transparent"/>
                                        <Button x:Name="BtnDeleteOrder" Content="🗑️" Click="BtnDeleteOrder_Click" Margin="3" Background="Transparent"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                
            </TabItem>
        </TabControl>
    </Grid>
</Page>
