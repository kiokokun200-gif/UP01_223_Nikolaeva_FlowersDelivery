<Page x:Class="UP01_223_Nikolaeva.Pages.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_223_Nikolaeva.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0 0 30 0">
            <TextBlock Text="{Binding Rating}" FontSize="30" HorizontalAlignment="Right"/>
            <Image Grid.Column="0" VerticalAlignment="Center" Height="300" Width="300" Source="{Binding ImagePath}"/>
            
        </Grid>


        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}" FontSize="30"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Price, StringFormat={}{0:F2} P}" Margin="0 0 10 0" />
             
            </StackPanel>
            <TextBlock Text="{Binding GoodCategory.Name, StringFormat=Категория: {0}}" FontSize="20"/>
            <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}" FontSize="20"/> <!--добавить в бд-->
            <ListBox x:Name="ListBoxReview" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{Binding User.Name}"  FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Date, StringFormat=dd MMMM yyyy}" FontSize="14"/>

                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                                    <Button x:Name="BtnComplaintReview" ToolTip="Пожаловаться на отзыв" Content="⚠" FontSize="10" BorderThickness="0" Height="30" Click="BtnComplaintReview_Click"/>
                                    <Button x:Name="BtnFrozeReview" Visibility="{Binding VisIsAdmin}" Content="Заморозить"  Click="BtnFrozeReview_Click"   />
                                    <TextBlock  HorizontalAlignment="Right" Text="{Binding Rating, StringFormat={}★{0}}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Comment}"/>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
